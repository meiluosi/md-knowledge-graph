{
  "name": "md-knowledge-graph",
  "version": "1.0.0",
  "description": "[已冻结·维护模式] 检查 markdown 语料的引用完整性与标签一致性；支持基线（只挡新增）、规则可配置、无 frontmatter 的纯 markdown。注意：客观检查部分与 lychee 重叠，详见 docs/retrospective.md",
  "type": "module",
  "license": "MIT",
  "author": "枫语 (Feng Yu)",
  "keywords": [
    "markdown",
    "knowledge-graph",
    "frontmatter",
    "tags",
    "links",
    "anchor",
    "lint",
    "related-posts",
    "broken-links",
    "broken-images",
    "cli",
    "config",
    "rules",
    "linter"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "bin": {
    "mdkg": "./src/cli.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "example": "node src/cli.js --posts examples --out examples/graph.json --format json",
    "example:html": "node src/cli.js --posts examples --out examples/graph.html --format html",
    "example:mermaid": "node src/cli.js --posts examples --out examples/graph.mmd --format mermaid",
    "example:related": "node src/cli.js --posts examples --out examples/related.json --format related",
    "check:examples": "node src/cli.js --posts examples --check",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3"
  }
}
