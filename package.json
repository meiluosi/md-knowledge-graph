{
  "name": "md-knowledge-graph",
  "version": "0.8.1",
  "description": "检查 markdown 知识库：失效锚点/断链/本地路径/缺失图片/标签一致性 · 支持无 frontmatter 的纯 markdown · 基线只挡新增 · 附 GitHub Action 与 pre-commit",
  "type": "module",
  "license": "MIT",
  "author": "枫语 (Feng Yu)",
  "keywords": [
    "markdown",
    "knowledge-graph",
    "frontmatter",
    "tags",
    "links",
    "anchor",
    "lint",
    "related-posts",
    "broken-links",
    "broken-images",
    "cli",
    "config",
    "rules",
    "linter"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "bin": {
    "mdkg": "./src/cli.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "example": "node src/cli.js --posts examples --out examples/graph.json --format json",
    "example:html": "node src/cli.js --posts examples --out examples/graph.html --format html",
    "example:mermaid": "node src/cli.js --posts examples --out examples/graph.mmd --format mermaid",
    "example:related": "node src/cli.js --posts examples --out examples/related.json --format related",
    "check:examples": "node src/cli.js --posts examples --check",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3"
  }
}
